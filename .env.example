# SPLSEO Webapp Server Config

PORT=3001
NODE_ENV=production

# Production examples:
# LICENSE_SERVER_URL=https://manager.splworks.com
# CLIENT_URL=https://seo.splworks.com
# ALLOWED_ORIGINS=https://seo.splworks.com
# GOOGLE_REDIRECT_URI=https://api-seo.splworks.com/api/gsc/callback
LICENSE_SERVER_URL=http://localhost:3002
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Development only. Keep false or remove in production.
DEV_SKIP_AUTH=false
ALLOW_LICENSE_FALLBACK=false

# Google OAuth / Search Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/gsc/callback

# Optional shared Google service account for GSC indexing workflows.
SPLSEO_GOOGLE_SA_EMAIL=
SPLSEO_GOOGLE_SA_JSON=
